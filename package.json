{
  "name": "meteorite-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A beginner-friendly interactive meteorite atlas.",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "fetch:images": "node scripts/fetch-wikimedia-images.mjs",
    "cache:images": "node scripts/cache-approved-images.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "validate:data": "node scripts/validate-data.mjs",
    "check": "npm run validate:data && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@vitejs/plugin-react": "4.7.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "vite": "6.4.3"
  }
}
